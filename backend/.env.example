# ==============================================================================
# 🚀 SHIPHNY AI SUPPORT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# 💡 RECRUITER / EVALUATION NOTE:
# This file provides the necessary environment variables to run the backend 
# locally using Docker Compose without needing any paid services.
# 
# Simply copy this file to `.env` (cp .env.example .env) before running
# docker-compose up.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Shiphny SupportBot Pro"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7" # Dummy dev key
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:80", "*"]'

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATIONS (Handled automatically by Docker Compose)
# ------------------------------------------------------------------------------
# These are overridden by docker-compose.yml, but kept here for reference
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/shippny_db"
DATABASE_URL_SYNC="postgresql://postgres:postgres@db:5432/shippny_db"
REDIS_URL="redis://redis:6379/0"

# ------------------------------------------------------------------------------
# 3. AI PROVIDER KEYS (Groq is completely FREE)
# ------------------------------------------------------------------------------
# Get your free Groq API key here: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_free_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"

# Optional keys (if you want to test other models in the codebase)
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
